{
  "name": "itacademy-sprint4",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "test": "jest",
    "build": "jest && cp test-results.html index.html",
    "test:watch": "jest --watchAll --verbose=true"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^17.0.0",
    "jest-stare": "^2.5.0"
  },
  "jest-junit": {
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none"
  },
  "dependencies": {
    "browserify": "^17.0.0"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "./node_modules/jest-html-reporter",
        {
          "pageTitle": "Test Solution",
          "outputPath": "test-results.html",
          "includeFailureMsg": true,
          "includeConsoleLog": true
        }
      ]
    ],
    "reportersStare": [
      "default",
      [
        "jest-stare",
        {
          "resultDir": "results/jest-stare",
          "reportTitle": "jest-stare!",
          "additionalResultsProcessors": [
            "jest-junit"
          ],
          "coverageLink": "../../coverage/lcov-report/index.html",
          "jestStareConfigJson": "jest-stare.json",
          "jestGlobalConfigJson": "globalStuff.json"
        }
      ]
    ]
  },
  "overrides": {
    "elliptic": "npm:@unabandoned/elliptic@7.0.0"
  }
}